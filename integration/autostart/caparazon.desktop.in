[Desktop Entry]
Type=Application
Name=Caparazón
Comment=Shell de escritorio para Plasma 6 y niri (Quickshell)
Exec=@SHELL_PATH@/scripts/caparazon-shell
Icon=quickshell
Terminal=false
NoDisplay=false
X-KDE-autostart-after=panel
X-KDE-autostart-phase=2
# Sin OnlyShowIn: la shell arranca tanto en Plasma como en niri.
