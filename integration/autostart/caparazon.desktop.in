[Desktop Entry]
Type=Application
Name=Caparazón
Comment=Shell de escritorio para Plasma 6 (Quickshell)
Exec=env MALLOC_ARENA_MAX=2 MALLOC_TRIM_THRESHOLD_=131072 mesa_glthread=false quickshell -p @SHELL_PATH@ -d
Icon=quickshell
Terminal=false
NoDisplay=false
X-KDE-autostart-after=panel
X-KDE-autostart-phase=2
OnlyShowIn=KDE;
