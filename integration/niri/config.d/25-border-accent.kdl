// Generado por accent-theme: el borde y el fondo del overview de niri
// siguen el acento de la shell.
// No editar a mano; el motor lo reescribe en cada cambio de tema.
layout {
    border {
        on
        width 2
        active-color "#3daee9"
        inactive-color "#18465d"
        urgent-color "#cc4444"
    }
}

overview {
    backdrop-color "#18455d"
}
