#!/usr/bin/env bash
# Caparazón — lanzador manual de la shell con escala.
#
# El arranque automático no pasa por aquí: systemd aplica la escala con un
# drop-in (EnvironmentFile). Este script sirve para lanzarla a mano desde una
# terminal conservando la escala elegida en Configs.
set -u

shell_dir="$(cd "$(dirname "$0")/.." && pwd)"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/caparazon"

scale=1
for candidate in "$config_dir/scale.env" "$config_dir/scale"; do
    [ -r "$candidate" ] || continue
    held="$(sed -n 's/^QT_SCALE_FACTOR=//p' "$candidate" | head -n 1)"
    [ -n "$held" ] || held="$(head -n 1 "$candidate")"
    case "$held" in
        0.5|0.75|1|1.25|1.5) scale="$held" ;;
    esac
    break
done

export QT_SCALE_FACTOR="$scale"
exec env MALLOC_ARENA_MAX=2 MALLOC_TRIM_THRESHOLD_=131072 mesa_glthread=false \
    quickshell -p "$shell_dir" -d
